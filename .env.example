# LLM 摘要配置
LLM_MODE=auto
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MAX_TOKENS=4000
LLM_TIMEOUT_SECONDS=180
LLM_RUN_TOKEN_BUDGET=12000
LLM_COST_BUDGET_USD=0
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0

# 内部 API 路径
API_CACHE_PATH=data/cache/quarterly_fundamentals.sec.json
API_CHECKPOINT_DB=data/checkpoints.api.sqlite
API_TRACE_DIR=data/traces
API_REPORT_DIR=data/reports
API_NEWS_CACHE_PATH=data/cache/news_events.sec.json
API_REQUIRE_AUTH=true
API_AUTH_TOKEN=replace-with-a-long-random-token

# SEC 抓取配置
SEC_USER_AGENT=fundamental-agent-demo/0.1 research contact@example.com
